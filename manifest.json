{
  "$schema": "https://json.schemastore.org/chrome-manifest",
  "manifest_version": 3,
  "name": "JSONLens JSON Viewer",
  "version": "1.0.0",
  "description": "Beautifully renders JSON pages with dark theme.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JSONLens JSON Viewer"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/GeistMono-Regular.woff2", "fonts/GeistMono-Medium.woff2"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
